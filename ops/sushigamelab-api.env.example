# Install as /etc/sushigamelab-api.env, owned root:sushigamelab, mode 0640.
# Do not put the real environment file in Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=3030
PUBLIC_ORIGIN=https://sushigamelab.com
SGL_DB_PATH=/var/lib/sushigamelab/sushigamelab.sqlite

# Password hashing defaults are intentionally expensive. Leave these unset
# unless a measured production benchmark shows the server needs tuning.
# SGL_SCRYPT_N=32768
# SGL_SCRYPT_R=8
# SGL_SCRYPT_P=3

# Optional. Shared with a game's trusted scoring server so it can mark a run
# 'verified'; leave unset and every score stays 'community'.
#   SGL_VERIFIER_SECRET=<64 hex chars, openssl rand -hex 32>

# Optional. Enables the moderation routes under /sushi-api/admin. Without it
# those routes answer 404, so the API does not advertise what it cannot do.
#   SGL_ADMIN_TOKEN=<32+ random characters>

# Optional. Shifts the weekly and seasonal boundaries out of UTC. Left unset the
# week rolls over at UTC midnight, which is Sunday afternoon on the Pacific coast.
#   SGL_WEEK_TZ_OFFSET_MIN=-480
